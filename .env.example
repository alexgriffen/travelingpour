# Coming-soon gate.
# When set to "true", every route serves the /coming-soon landing page and the
# full site (nav, footer, all other pages) is hidden. Set to "false" or remove
# it to launch the full site. On Vercel, changing this triggers a rebuild.
# The notify-me signup form on the coming-soon page reuses the Resend vars below.
COMING_SOON=true

# Contact form — Resend (https://resend.com)
# The booking inquiry form sends email via a server action using these.

# Your Resend API key (Resend dashboard → API Keys)
RESEND_API_KEY=

# Where booking inquiries are delivered. This MUST be a real inbox you can
# receive mail at (e.g. your Gmail). Resend only SENDS email — it does not
# receive — so this cannot be an @travelingpour.com address unless you've set
# up actual email hosting (Google Workspace, etc.) with MX records.
INQUIRY_TO_EMAIL=you@gmail.com

# Verified sender address. Must be on a domain you've verified in Resend.
# Format: "Display Name <address@yourdomain.com>"
# Before your domain is verified, use: "Traveling Pour Bar <onboarding@resend.dev>"
INQUIRY_FROM_EMAIL=Traveling Pour Bar <inquiries@travelingpour.com>
